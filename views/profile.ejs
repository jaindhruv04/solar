<%- include('./partials/header') %>

<div class="flex flex-1 items-start justify-center bg-slate-50 px-5 py-10 lg:px-10 lg:py-14">
  <div class="w-full max-w-lg">

    <div class="mb-6 flex flex-col items-center">
      <div class="flex h-24 w-24 items-center justify-center rounded-full bg-slate-900 text-3xl font-bold text-white">
        <% if(user.picture){ %>
        <img class="h-24 w-24 rounded-full object-cover" src="<%= user.picture %>" alt="">
        <% } else { %>
        <%= user.fullname.charAt(0).toUpperCase() %>
        <% } %>
      </div>
      <h2 class="mt-4 text-xl font-bold text-slate-800"><%= user.fullname %></h2>
      <p class="text-sm text-slate-500"><%= user.email %></p>
    </div>

    <div class="rounded-2xl bg-white p-6 shadow-md">
      <h3 class="mb-5 rounded-xl bg-slate-900 py-3 text-center text-xl font-semibold text-white">Edit Profile</h3>
      <form action="/users/profile" method="POST" enctype="multipart/form-data">
        <div class="mb-4">
          <label class="mb-1 block text-sm font-medium text-slate-700">Profile Picture</label>
          <input name="picture" type="file" accept="image/*" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-800 outline-none focus:border-slate-400 file:mr-3 file:rounded-lg file:border-0 file:bg-slate-900 file:px-3 file:py-1 file:text-sm file:text-white file:cursor-pointer">
        </div>
        <div class="mb-4">
          <label class="mb-1 block text-sm font-medium text-slate-700">Full Name</label>
          <input name="fullname" type="text" value="<%= user.fullname %>" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-800 outline-none focus:border-slate-400">
        </div>
        <div class="mb-4">
          <label class="mb-1 block text-sm font-medium text-slate-700">Email</label>
          <input type="text" value="<%= user.email %>" disabled class="w-full rounded-xl border border-slate-200 bg-slate-100 px-4 py-3 text-sm text-slate-400 outline-none cursor-not-allowed">
        </div>
        <div class="mb-6">
          <label class="mb-1 block text-sm font-medium text-slate-700">Contact</label>
          <input name="contact" type="text" value="<%= user.contact || '' %>" placeholder="Enter your contact number" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-800 outline-none focus:border-slate-400">
        </div>
        <button type="submit" class="w-full rounded-xl bg-slate-900 py-3 font-semibold text-white transition-colors hover:bg-[#ffd266] hover:text-slate-900">Save Changes</button>
      </form>
    </div>

  </div>
</div>

<%- include('./partials/footer') %>
