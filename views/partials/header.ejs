<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Solar</title>
  <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen flex flex-col font-sans" style="background-color: #F5F7F8;">
  <nav class="relative z-50 flex w-full items-center justify-between gap-3 border-b border-slate-700 px-4 py-4 sm:px-8 sm:py-5" style="background-color: #081020;">
    <a href="/shop" class="text-2xl font-bold tracking-tight text-[#ffd266] sm:text-3xl ">SOLAR</a>
    <% var loggedin = typeof loggedin != "undefined" ? loggedin : true %>
    <% if(loggedin){ %>
    <div class="flex items-center gap-2 text-xs sm:gap-6 sm:text-base">
      <div class="hidden items-center overflow-hidden rounded-lg border border-slate-600 sm:flex">
        <a class="px-4 py-2 text-gray-100 transition-colors hover:text-[#ffd266]" href="/shop">Shop</a>
        <a class="px-4 py-2 text-gray-100 transition-colors hover:text-[#ffd266]" href="/cart">Cart</a>
      </div>
      <% if(user && user.email === "dhruvjain0412@gmail.com"){ %>
      <div class="relative">
        <button onclick="toggleDropdown()" class="flex h-8 w-8 items-center justify-center rounded-full bg-white text-sm font-bold text-slate-900 transition-opacity hover:opacity-80"><%= user.fullname.charAt(0).toUpperCase() %></button>
        <div id="avatar-dropdown" class="absolute right-0 top-10 z-50 hidden w-48 rounded-xl bg-white py-2 shadow-lg">
          <a class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-100 sm:hidden" href="/shop">Shop</a>
          <a class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-100 sm:hidden" href="/cart">Cart</a>
          <a class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-100" href="/owners/admin">Admin</a>
          <a class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-100" href="/profile">Profile</a>
          <a class="block px-4 py-2 text-sm text-red-500 hover:bg-slate-100" href="/users/logout" onclick="return confirm('Are you sure you want to logout?')">Logout</a>
        </div>
      </div>
      <% } else if(user){ %>
      <div class="relative">
        <button onclick="toggleDropdown()" class="flex h-8 w-8 items-center justify-center rounded-full bg-white text-sm font-bold text-slate-900 transition-opacity hover:opacity-80"><%= user.fullname.charAt(0).toUpperCase() %></button>
        <div id="avatar-dropdown" class="absolute right-0 top-10 z-50 hidden w-48 rounded-xl bg-white py-2 shadow-lg">
          <a class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-100 sm:hidden" href="/shop">Shop</a>
          <a class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-100 sm:hidden" href="/cart">Cart</a>
          <a class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-100" href="/profile">Profile</a>
          <a class="block px-4 py-2 text-sm text-red-500 hover:bg-slate-100" href="/users/logout" onclick="return confirm('Are you sure you want to logout?')">Logout</a>
        </div>
      </div>
      <% } %>
    </div>
    <% } %>
  </nav>
  <script>
    function toggleDropdown() {
      let d = document.getElementById('avatar-dropdown');
      d.classList.toggle('hidden');
    }
    document.addEventListener('click', function(e) {
      let d = document.getElementById('avatar-dropdown');
      if(d && !e.target.closest('.relative')) d.classList.add('hidden');
    });
  </script>